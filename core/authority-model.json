{
  "bootstrap_rule": "authority.json configures root ceilings and Activation only. Root command proofs bind one command intent and may issue only the first authority.manage Grant. Every Grant proof binds claim_digest; later Grants cite an active authority.manage issuer Grant or team signatures verified by the exact signature adapter selected in technologies.json.",
  "canonical_timestamp_contract": {
    "calendar": "proleptic-gregorian",
    "format": "utc-second-z",
    "formatter_api": "promin.canonical.format_utc_second(value: datetime) -> str",
    "fractional_seconds": "reject",
    "normalization": "identity-round-trip",
    "offset": "Z-only",
    "parser_api": "promin.canonical.parse_utc_second(value: str) -> timezone-aware UTC datetime",
    "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
    "real_calendar_validation": true,
    "resolution_seconds": 1,
    "year_max": 9999,
    "year_min": 1
  },
  "capabilities": [
    {
      "id": "standard.activate",
      "purpose": "Activate one digest-bound repository configuration."
    },
    {
      "id": "authority.manage",
      "purpose": "Issue or revoke runtime Grants within a configured root ceiling."
    },
    {
      "id": "task.plan",
      "purpose": "Create, split, order, or block Tasks."
    },
    {
      "id": "task.execute",
      "purpose": "Execute one Task inside its WorkCard and valid Lease."
    },
    {
      "id": "lease.manage",
      "purpose": "Acquire, heartbeat, close, expire, or revoke Leases."
    },
    {
      "id": "evidence.publish",
      "purpose": "Publish candidate-bound evidence Artifacts."
    },
    {
      "id": "validation.evaluate",
      "purpose": "Evaluate gates without promotion or release authority."
    },
    {
      "id": "finding.record",
      "purpose": "Record Findings."
    },
    {
      "id": "finding.resolve",
      "purpose": "Resolve one Finding only with evidence bound to that Finding's canonical digest."
    },
    {
      "id": "finding.waive",
      "purpose": "Waive one Finding only through an expiring exception-policy Decision, Finding-bound evidence, and separation of duties."
    },
    {
      "id": "candidate.promote",
      "purpose": "Promote a validated Candidate."
    },
    {
      "id": "release.decide",
      "purpose": "Record an immutable historical release judgement bound to an exact acceptance-closure and provider-binding digest; current eligibility remains derived."
    },
    {
      "id": "export.create",
      "purpose": "Create a sanitized external package."
    },
    {
      "id": "migration.manage",
      "purpose": "Execute cutover, rollback, and deterministic recutover."
    },
    {
      "id": "projection.rebuild",
      "purpose": "Rebuild or verify non-authoritative projections."
    },
    {
      "id": "projection.read",
      "purpose": "Read one bounded current projection or resume its continuation under the exact current Grant claim; it grants no mutation, validation, promotion, product acceptance, or standard distribution authority."
    }
  ],
  "command_capability_rules": [
    {
      "capability_id": "task.plan",
      "command_kind": "task.record"
    },
    {
      "capability_id": "task.plan",
      "command_kind": "task.transition"
    },
    {
      "capability_id": "task.execute",
      "command_kind": "candidate.record"
    },
    {
      "capability_by_value": {
        "diff": "task.execute",
        "evidence": "evidence.publish",
        "log": "task.execute",
        "product": "task.execute",
        "report": "projection.rebuild"
      },
      "command_kind": "artifact.record",
      "payload_field": "artifact_kind"
    },
    {
      "capability_by_value": {
        "execution": "task.execute",
        "validation": "validation.evaluate"
      },
      "command_kind": "run.record",
      "payload_field": "run_kind"
    },
    {
      "capability_id": "validation.evaluate",
      "command_kind": "gate.record"
    },
    {
      "capability_id": "finding.record",
      "command_kind": "finding.record"
    },
    {
      "capability_by_value": {
        "accept": "validation.evaluate",
        "promote": "candidate.promote",
        "reject": "validation.evaluate",
        "release": "release.decide",
        "resolve": "finding.resolve",
        "revoke": "authority.manage",
        "waive": "finding.waive"
      },
      "command_kind": "decision.record",
      "payload_field": "decision_kind"
    },
    {
      "capability_id": "authority.manage",
      "command_kind": "grant.issue"
    },
    {
      "capability_id": "authority.manage",
      "command_kind": "grant.revoke"
    },
    {
      "capability_id": "lease.manage",
      "command_kind": "lease.record"
    }
  ],
  "command_effect_scope_rules": [
    {
      "command_kind": "task.record",
      "id_field": "task_id",
      "kind": "task",
      "mode": "payload-id"
    },
    {
      "command_kind": "task.transition",
      "id_field": "task_id",
      "kind": "task",
      "mode": "payload-id"
    },
    {
      "command_kind": "candidate.record",
      "id_field": "candidate_id",
      "kind": "candidate",
      "mode": "payload-id"
    },
    {
      "command_kind": "artifact.record",
      "id_field": "artifact_id",
      "kind": "artifact",
      "mode": "payload-id"
    },
    {
      "command_kind": "run.record",
      "mode": "payload-multi-id",
      "targets": [
        {
          "id_field": "task_id",
          "kind": "task"
        },
        {
          "id_field": "candidate_digest",
          "kind": "candidate"
        }
      ]
    },
    {
      "command_kind": "gate.record",
      "id_field": "candidate_digest",
      "kind": "candidate",
      "mode": "payload-id"
    },
    {
      "command_kind": "finding.record",
      "id_field": "finding_id",
      "kind": "finding",
      "mode": "payload-id"
    },
    {
      "command_kind": "decision.record",
      "grant_target_type": "Grant",
      "id_field": "target_id",
      "kind_field": "target_type",
      "kind_map": {
        "Candidate": "candidate",
        "Finding": "finding",
        "Task": "task"
      },
      "mode": "payload-dynamic-id-or-referenced-grant-scope"
    },
    {
      "command_kind": "grant.issue",
      "mode": "payload-scope",
      "scope_field": "scope"
    },
    {
      "command_kind": "grant.revoke",
      "grant_id_field": "grant_id",
      "mode": "referenced-grant-scope"
    },
    {
      "command_kind": "lease.record",
      "id_field": "task_id",
      "kind": "task",
      "mode": "payload-id"
    }
  ],
  "command_mutation_claim_rule": {
    "binding_equalities": [
      "CommandRequest.workcard_task_id == WorkCard.task_id == Lease.task_id",
      "CommandRequest.subject_id == Lease.holder_subject_id",
      "CommandRequest.holder_authorization.grant_id == WorkCard.holder_grant_id == Lease.holder_grant_id",
      "CommandRequest.lease_id == WorkCard.lease_id == Lease.lease_id",
      "CommandRequest.lease_generation == WorkCard.lease_generation == Lease.generation",
      "CommandRequest.fencing_token == WorkCard.fencing_token == Lease.fencing_token",
      "CommandRequest.context_digest == WorkCard.context_digest",
      "CommandRequest.workcard_digest == sha256(canonical WorkCard)"
    ],
    "claim_rule": "A lease-bound command is admissible only when authorization proves the exact command capability, holder_authorization independently proves task.execute, both exact Grant claims bind the same subject, Activation and conjunctive effect scope, the referenced Lease is current and ACTIVE at issued_at, and task, generation, fence, candidate, context, and WorkCard digests match exactly.",
    "command_authorization_source": "CommandRequest.authorization.grant_id + grant_claim_digest",
    "grant_separation_rule": "The command authorization Grant and holder Grant are resolved and validated independently; they may be the same record only when the required command capability is task.execute.",
    "holder_grant_capability": "task.execute",
    "holder_grant_field": "holder_authorization.grant_id",
    "lease_bound_command_kinds": [
      "artifact.record",
      "run.record",
      "gate.record",
      "finding.record"
    ],
    "lease_bound_task_transition_states": [
      "LEASED",
      "RUNNING",
      "COMPLETED"
    ],
    "lease_required_state": "ACTIVE",
    "required_command_fields": [
      "workcard_task_id",
      "holder_authorization",
      "lease_id",
      "lease_generation",
      "fencing_token",
      "workcard_digest",
      "context_digest"
    ],
    "required_workcard_fields": [
      "holder_grant_id",
      "lease_id",
      "lease_generation",
      "fencing_token",
      "context_digest"
    ],
    "stale_or_unresolved": "reject"
  },
  "continuation_access_rule": {
    "authority_effect": false,
    "authorization_rule": "Initial retrieval and every continuation resume require a current projection.read Grant whose subject, grant_id, claim_digest, capability, Activation, conjunctive requested scope, interval, and revocation state match the token claims exactly.",
    "capability_id": "projection.read",
    "default_budget_source": "selected Preset profile max_context_bytes, max_entities, max_relations, max_fanout_per_entity, and top_k",
    "default_depth_source": "selected Preset profile default_dependency_depth",
    "default_ttl_seconds": 900,
    "depth_max_source": "Conformance.dependency_depth_hard_max",
    "depth_min": 1,
    "hard_budget_source": "Conformance.workcard_hard_ceiling",
    "max_continuation_state_bytes_source": "Conformance.scale_contracts.workcard.continuation_state_bytes_max",
    "max_query_bytes_source": "PolicySet.derived_result_contracts.RetrievalPage.query_bytes_max",
    "max_resume_binding_bytes": 4096,
    "max_resume_binding_fields": 8,
    "max_resume_binding_key_chars": 64,
    "max_resume_binding_value_bytes": 512,
    "min_result_bytes": 1024,
    "persistent_entity_types_source": "SemanticModel.persistent_entities.kind-in-owner-order",
    "ranking_algorithm_id": "bm25-v1",
    "required_claims": [
      "activation_digest",
      "subject_id",
      "grant_id",
      "grant_claim_digest",
      "capability_id",
      "requested_scope",
      "normalized_query_digest",
      "cursor",
      "head_event_id",
      "head_sequence",
      "head_digest",
      "projection_digest",
      "ranking_id",
      "traversal_id",
      "dependency_depth",
      "budgets",
      "issued_at",
      "expires_at",
      "ttl_seconds",
      "revocation_epoch",
      "implementation_closure_digest",
      "state_id"
    ],
    "required_resume_binding_fields": [
      "activation_digest",
      "capability_id",
      "grant_claim_digest",
      "grant_id",
      "implementation_closure_digest",
      "requested_scope_digest",
      "revocation_epoch",
      "subject_id"
    ],
    "revocation_rule": "Expired, revoked, substituted, stale, mismatched, or unresolved Grant claims reject before projection continuation.",
    "secret_lifecycle": "Generate one random 32-byte secret per Activation, store it only under .promin/state/secrets with restrictive permissions, never derive it from public package or control digests, never journal or export it, and rotate it with Activation.",
    "selected_profile_digest_rule": "sha256(canonical exact selected Preset profile object)",
    "selected_profile_id_source": "Activation.operating_profile",
    "state_digest_rule": "sha256(canonical full ContinuationTokenClaims); the compact token MAC binds token version, opaque state_id, state digest, Activation, subject, Grant claim, and expiry",
    "state_persistence": "derived-live-only",
    "token_envelope": "promin-v2.<base64url opaque 128-bit state handle>.<lowercase state digest>.<base64url HMAC-SHA256>",
    "token_max_bytes_source": "Conformance.scale_contracts.workcard.continuation_token_bytes_max",
    "token_version": 2,
    "traversal_algorithm_id": "typed-bfs-v2",
    "ttl_min_seconds": 1,
    "ttl_seconds_max": 3600
  },
  "default": "deny",
  "delegation_depth_max": 8,
