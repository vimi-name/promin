  },
  "document": "promin.authority-model",
  "event_contract": {
    "auxiliary_event_kinds": [
      "relation.recorded"
    ],
    "command_bytes_max": 1048576,
    "command_conditional_fields": [
      "definition_digest"
    ],
    "command_required_fields": [
      "record_type",
      "command_id",
      "command_kind",
      "subject_id",
      "activation_digest",
      "idempotency_key",
      "requested_scope",
      "expected_head_digest",
      "issued_at",
      "payload",
      "intent_digest",
      "authorization"
    ],
    "command_to_primary_event": {
      "artifact.record": "artifact.recorded",
      "candidate.record": "candidate.recorded",
      "decision.record": "decision.recorded",
      "finding.record": "finding.recorded",
      "gate.record": "gate.recorded",
      "grant.issue": "grant.issued",
      "grant.revoke": "grant.revoked",
      "lease.record": "lease.recorded",
      "run.record": "run.recorded",
      "task.record": "task.recorded",
      "task.transition": "task.transitioned"
    },
    "derived_tail_batch_threshold": 128,
    "derived_tail_byte_threshold": 8388608,
    "envelope_bytes_max": 2097152,
    "event_batch_commitment_rule": {
      "authority_commitment": "sha256(canonical object with exactly previous_authority_commitment, sequence, previous_batch_digest, event_count, event_semantic_digest, state_binding_update_count, state_binding_digest)",
      "cumulative_event_count": "previous cumulative_event_count plus current events length",
      "cumulative_state_binding_update_count": "previous cumulative state-binding update count plus current state_binding_delta length",
      "event_semantic_digest": "ordered append-only digest over every canonical Event",
      "previous_authority_commitment": "exact previous EventBatch authority_commitment; sequence one uses genesis_previous_authority_commitment",
      "state_binding_delta": "nonempty canonical ordered unique set/delete updates over changed typed authority leaves only",
      "state_binding_digest": "exact typed-sparse-merkle-v1 post-batch authority root using runtime domain separators for leaf and internal nodes; never a full serialized state hash"
    },
    "event_batch_required_fields": [
      "record_type",
      "batch_id",
      "sequence",
      "previous_digest",
      "previous_authority_commitment",
      "authority_commitment",
      "cumulative_event_count",
      "event_semantic_digest",
      "state_binding_delta",
      "cumulative_state_binding_update_count",
      "state_binding_digest",
      "created_at",
      "command_id",
      "idempotency_key",
      "activation_record_digest",
      "events",
      "subject_id",
      "command_intent_digest",
      "command_digest",
      "authorization_digest"
    ],
    "event_required_fields": [
      "record_type",
      "event_id",
      "event_kind",
      "activation_digest",
      "payload"
    ],
    "events_per_batch_max": 20,
    "genesis_event_semantic_digest": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
    "genesis_previous_authority_commitment": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855",
    "lease_bound_command_kinds_source": "command_mutation_claim_rule.lease_bound_command_kinds",
    "lease_bound_task_transition_states_source": "command_mutation_claim_rule.lease_bound_task_transition_states",
    "primary_event_count_per_command": 1,
    "requested_scope_items_max_source": "scope_contract.requested_scope_items_max",
    "runtime_overlay_compaction_depth": 64,
    "state_binding_algorithm": "typed-sparse-merkle-v1",
    "state_binding_algorithm_contract": {
      "delete_rule": "delete maps the keyed leaf to empty_leaf",
      "delta_order": [
        "leaf_type-ascending",
        "leaf_id-ascending"
      ],
      "depth": 256,
      "depth_encoding": "unsigned-16-bit-big-endian",
      "empty_leaf_domain_utf8": "promin:typed-sparse-merkle-v1:empty-leaf",
      "internal_node_domain_utf8": "promin:typed-sparse-merkle-v1:node\u0000",
      "internal_node_rule": "sha256(domain + depth_uint16_be + left_32_bytes + right_32_bytes)",
      "leaf_domain_utf8": "promin:typed-sparse-merkle-v1:leaf\u0000",
      "leaf_key_rule": "sha256(canonical bytes of exact object leaf_type and leaf_id)",
      "set_leaf_rule": "sha256(domain + leaf_key_32_bytes + value_digest_32_bytes)"
    },
    "state_binding_bytes_max": 1048576,
    "state_binding_identity_rule": "direct uses the exact id field; typed_digest_id uses prefix plus first 48 lowercase hex characters of sha256(canonical ordered id_fields array)",
    "state_binding_identity_rules": {
      "Activation": {
        "id_fields": [
          "activation_digest"
        ],
        "identity_mode": "direct"
      },
      "Artifact": {
        "id_fields": [
          "artifact_id"
        ],
        "identity_mode": "direct"
      },
      "Candidate": {
        "id_fields": [
          "candidate_id"
        ],
        "identity_mode": "direct"
      },
      "Decision": {
        "id_fields": [
          "decision_id"
        ],
        "identity_mode": "direct"
      },
      "Finding": {
        "id_fields": [
          "finding_id"
        ],
        "identity_mode": "direct"
      },
      "GateResult": {
        "digest_algorithm": "sha256",
        "digest_hex_chars": 48,
        "digest_input": "canonical-ordered-id-field-values",
        "id_fields": [
          "gate_id",
          "run_id"
        ],
        "identity_mode": "typed_digest_id",
        "prefix": "gate-result:"
      },
      "Grant": {
        "id_fields": [
          "grant_id"
        ],
        "identity_mode": "direct"
      },
      "Lease": {
        "id_fields": [
          "lease_id"
        ],
        "identity_mode": "direct"
      },
      "Relation": {
        "id_fields": [
          "relation_id"
        ],
        "identity_mode": "direct"
      },
      "Run": {
        "id_fields": [
          "run_id"
        ],
        "identity_mode": "direct"
      },
      "Task": {
        "id_fields": [
          "task_id"
        ],
        "identity_mode": "direct"
      }
    },
    "state_binding_leaf_type_source": "Activation plus SemanticModel.persistent_entities.kind plus Relation",
    "state_binding_updates_per_batch_max": 20,
    "state_binding_value_rules": {
      "Activation": {
        "event_kinds": [],
        "value_definition": "Activation",
        "value_digest_rule": "sha256(canonical installed Activation record); installed before sequence one and immutable for the journal"
      },
      "Artifact": {
        "event_kinds": [
          "artifact.recorded"
        ],
        "value_definition": "Artifact",
        "value_digest_rule": "sha256(canonical exact Event.payload Artifact)"
      },
      "Candidate": {
        "event_kinds": [
          "candidate.recorded"
        ],
        "value_definition": "Candidate",
        "value_digest_rule": "sha256(canonical exact Event.payload Candidate)"
      },
      "Decision": {
        "event_kinds": [
          "decision.recorded"
        ],
        "value_definition": "Decision",
        "value_digest_rule": "sha256(canonical exact Event.payload Decision)"
      },
      "Finding": {
        "event_kinds": [
          "finding.recorded"
        ],
        "value_definition": "Finding",
        "value_digest_rule": "sha256(canonical exact Event.payload Finding)"
      },
      "GateResult": {
        "event_kinds": [
          "gate.recorded"
        ],
        "value_definition": "GateResult",
        "value_digest_rule": "sha256(canonical exact Event.payload GateResult)"
      },
      "Grant": {
        "event_kinds": [
          "grant.issued",
          "grant.revoked"
        ],
        "value_definition": "GrantAuthorityState",
        "value_digest_rule": "sha256(canonical exact GrantAuthorityState containing the current Grant and null or exact current GrantRevocation)"
      },
      "Lease": {
        "event_kinds": [
          "lease.recorded"
        ],
        "value_definition": "Lease",
        "value_digest_rule": "sha256(canonical exact Event.payload post-state Lease)"
      },
      "Relation": {
        "event_kinds": [
          "relation.recorded"
        ],
        "value_definition": "Relation",
        "value_digest_rule": "sha256(canonical exact Event.payload Relation)"
      },
      "Run": {
        "event_kinds": [
          "run.recorded"
        ],
        "value_definition": "Run",
        "value_digest_rule": "sha256(canonical exact Event.payload Run)"
      },
      "Task": {
        "event_kinds": [
          "task.recorded",
          "task.transitioned"
        ],
        "value_definition": "Task",
        "value_digest_rule": "sha256(canonical exact Event.payload post-state Task)"
      }
    },
    "timestamp_contract_source": "canonical_timestamp_contract"
  },
  "function": "Own action capabilities, runtime Grant semantics, trust modes, configured signature-adapter verification, root ceilings, and separation-of-duty constraints.",
  "grant_contract": {
    "claim_digest_rule": "sha256(canonical Grant without claim_digest and trust_proofs)",
    "nonce": {
      "max_length": 128,
      "min_length": 16,
      "pattern": "^[A-Za-z0-9._:-]{16,128}$"
    },
    "required_fields": [
      "record_type",
      "grant_id",
      "subject_id",
      "capability_id",
      "scope",
      "activation_digest",
      "issued_at",
      "expires_at",
