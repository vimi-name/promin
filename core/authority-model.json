    "lease_bound_task_transition_states_source": "command_mutation_claim_rule.lease_bound_task_transition_states",
    "persistence": "derived-live-only",
    "policy_digest_rule": "sha256(canonical EventStorePolicy without policy_digest)",
    "required_bindings": [
