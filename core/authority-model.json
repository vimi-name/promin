  "standard_release_decision_rule": {
    "chain": "exact candidate bytes -> StandardReleaseCandidateBinding -> seven unique stable-read authority-role records plus one non-authoritative exact eight-lane matrix and four CP314 supplemental records -> physically resolved StandardReleaseEvidenceManifest -> signed approve or reject StandardReleaseDecision -> independently pinned trust root -> derived distribution status",
    "chronology": "Every evidence invocation starts no later than it completes; its attestation time equals completion and stays within bounded verifier skew. Nested physical runs complete no later than their outer saturation audit, human review occurs inside its signed invocation, and max_evidence_completed_at is derived from all seven authority records, all nested physical records, and all four CP314 supplemental records. decided_at follows that maximum, is no more than 300 seconds beyond verifier time, and every producer/decision key is valid at its event time.",
    "decision_outcomes": [
      "approve",
      "reject"
    ],
    "derived_truths": "ExactPackageVerification is recomputed by the verifier and multi-platform implementation closure is derived only from fully authenticated Windows and Linux records; neither is an independently supplied required role or public command.",
    "evidence_binding": "Every authority, supplemental, matrix, and nested physical record binds exact path, SHA-256, and byte count and is read through a bounded handle-relative no-follow component walk. The manifest rejects symlink/junction/reparse/root substitution and NFC/casefold collisions, validates exact Draft 2020-12 schemas, verifies domain-separated producer attestations, binds producer/tool, role, platform, invocation, raw artifacts, and exact candidate, and runs role-specific semantic recomputation. The aggregate matrix remains non-authoritative with pass_credit=false and all acceptance/public flags false.",
    "history_and_current_state": "The signed StandardReleaseDecision and its digest remain immutable history. Current distribution eligibility is a derived view and becomes false when evidence, trust pin, candidate identity, chronology, key validity, or any required gate no longer validates.",
    "independent_trust_binding": "Manifest construction and closure verification require an independently operator-pinned SHA-256 for the exact trust configuration bytes. Exactly seven evidence roles have one distinct key, subject, and public key each; CP313 and CP314 observations for one role reuse only that role's configured producer. A mismatched, missing, duplicate, over-broad, or invalid scope cannot yield evidence credit or approval.",
    "location": "external-to-canonical-standard-folder",
    "product_acceptance_pass": false,
    "product_public_approval": "not_approved",
    "publication_rule": "Only outcome approve signed by an active configured Ed25519 key with standard.distribute capability and verified against an independently pinned trust-root SHA-256 yields approved distribution status. Missing, rejected, stale, unsigned, mismatched, unpinned, fabricated, or unresolved records fail closed.",
    "rule": "StandardReleaseDecision is external to the canonical standard bytes, binds candidate and evidence manifest digests, includes explicit outcome and anti-replay nonce, proves decider authority through a configured trust root and signature provider, and cannot elevate a trust root delivered by the same untrusted source without an independent digest pin.",
    "signature_algorithm": "Ed25519",
    "signature_provider_id": "cryptography-ed25519-v1",
    "standard_name": "promin",
    "version_source": "StandardReleaseCandidateBinding.version"
  },
  "trust_modes": {
    "local-owner": {
      "boundary": "single-machine owner-controlled root authority",
      "signer_required": false
    },
    "team-signed": {
      "boundary": "multiple actors or remote transport",
      "minimum_threshold": 1,
      "provider_capability": "signature",
      "provider_resolution": "Resolve the exact technologies.json signature binding for init and every ActivationGuard, service, CLI, replay, and mutation path. A process-local injected adapter is explicitly non-reconstructable and valid only while bound to the same project, Activation, provider, and identity; cross-process CLI workflows require a reconstructable configured adapter.",
      "signer_required": true,
      "unsupported_binding": "reject-before-workflow"
    }
  },
