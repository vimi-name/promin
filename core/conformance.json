      "continuation_state_bytes_max": 16384,
      "continuation_token_bytes_max": 256,
      "corpus_independent_output_bound": true,
      "seed_budget": "effective_top_k=min(profile.top_k,max(2,floor(max_entities/(1+observed_branching*requested_depth))))",
