{
  "admission": {
    "derived_by_default": "Each raw inventory file yields exactly one derived Artifact proxy. Raw-file proxies never create a persistent Task or relation; persistence still requires an independent invariant.",
    "entity": "EntityUtility=QueriesEnabled+RulesEnabled+AutomationEnabled-StorageCost-MaintenanceCost-NavigationNoise > 0",
    "relation": "RelationUtility=QueriesEnabled+RulesEnabled+SchedulingGain-WriteCost-FanoutNoise-Ambiguity > 0"
  },
  "derived_projection_kinds": [
    "InventoryEntry",
    "SearchDocument",
    "InventoryProjectionRow",
    "ProjectionLimits",
    "RetrievalPage",
    "ReadyFrontier",
    "WorkCardProjection",
    "WorkCard",
    "NextResult",
    "ContinueResult",
    "NavigationView",
    "StateCheckpoint",
    "CurrentReleaseStatus",
    "DoctorResult",
    "OperationMetrics",
    "Report"
  ],
  "design_rules": {
    "artifact_subtypes": {
      "candidate-delta": "An Artifact with kind diff binds one base Candidate, one new Candidate, one WorkCard, and the complete normalized changed-path set.",
      "evidence": "An evidence Artifact binds exact Candidate, policy, tool, inputs, and every invoked provider adapter; Finding disposition evidence additionally binds the canonical Finding digest."
    },
    "candidate_consistency": {
      "creditable": "Only an immutable-vcs-tree provider may produce a creditable Candidate in promin v1.",
      "observational": "A best-effort filesystem observation is explicit, non-creditable, and cannot receive product or release pass credit.",
      "recipe_binding": "Candidate identity binds the exact candidate_recipe digest, including include, exclude, path identity, collision, and symlink rules."
    },
    "granularities_are_independent": [
      "semantic",
      "public",
      "compilation",
      "runtime-dispatch",
      "documentation"
    ],
    "implementation_closure": {
      "activation_binding": "Activation binds the aggregate digest of every capability-specific implementation closure.",
      "binding_shape": "Each TechnologiesInit binding carries runtime, interpreter, zero or more capability components, exactly one matching adapter, and a recomputed closure_digest.",
      "required_components": {
        "control-runtime": [
          "promin-runtime",
          "python-interpreter"
        ],
        "query-projection": [
          "promin-runtime",
          "python-interpreter",
          "sqlite"
        ],
        "shape-validation": [
          "promin-runtime",
          "python-interpreter",
          "jsonschema"
        ]
      },
      "stale_rule": "A runtime, interpreter, component, adapter, or closure digest change invalidates the Activation and every dependent evidence Artifact, projection, continuation, and current release closure."
    },
    "inventory_projection": {
      "current_inventory_persistence": "derived-rebuild-only",
      "current_inventory_record_type": "CurrentInventory",
      "data_class": "untrusted-source",
      "derived_entity_type": "Artifact",
      "input": "Only a verified InventoryResult or its persisted manifest may enter the public rebuild path.",
      "input_manifest_persistence": "transient-ingress-only",
      "input_manifest_record_type": "InventoryInputManifest",
      "jsonl_row_fields": [
        "path",
        "digest",
        "size",
        "search_text"
      ],
      "one_file_rule": "Each verified raw file produces exactly one InventoryProjectionRow and one deterministic derived Artifact proxy.",
      "prohibited_derivations": [
        "Task",
        "READS",
        "PRODUCES"
      ],
      "reserved_provenance": [
        "data_class",
        "inventory_path",
        "inventory_digest"
      ],
      "runtime_owned_fields": [
        "path",
        "digest",
        "size",
        "inventory_path",
        "inventory_digest"
      ],
      "search_text_rule": "exact NFC-normalized canonical path, UTF-8 bounded by Conformance scale_contracts.inventory.search_text_bytes_max",
      "stream_artifact_kind": "report",
      "stream_artifact_record_digest_rule": "sha256(canonical finalized record with exact artifact and authoritative commit_binding)",
      "stream_media_type": "application/x-ndjson"
    },
    "promotion_test": [
      "independent-invariant",
      "independent-policy",
      "replaceability",
      "measurable-algorithm",
      "failure-boundary",
      "reuse",
      "domain-significance"
    ],
    "provider_invocation_evidence": {
      "diagnostic_capture_bytes_max": 1048576,
      "diagnostic_capture_fields": [
        "stdout_capture_digest",
        "stdout_capture_size_bytes",
        "stdout_capture_truncated",
        "stderr_capture_digest",
        "stderr_capture_size_bytes",
        "stderr_capture_truncated"
      ],
      "full_output_bytes_hard_max": 1099511627776,
      "full_output_fields": [
        "output_digest",
        "output_size_bytes",
        "output_size_ceiling_bytes"
      ],
      "full_output_rule": "output_digest and output_size_bytes cover the complete provider operation output stream; they are never derived from the bounded diagnostic captures",
      "immutable_tree_stream_rule": "filesystem-inventory immutable-tree-stream digests and counts the complete raw archive stream while stdout/stderr captures remain bounded diagnostics",
      "invocation_receipt_digest_rule": "sha256(canonical ProviderInvocationEvidence without invocation_receipt_digest)",
      "invocation_request_digest_rule": "sha256(canonical pre-invocation request receipt binding exact argv or module call, configured cwd, stdin digest, selected output ceiling, environment allowlist, provider identity, dependency receipt, and implementation closure)",
      "selected_ceiling_rule": "output_size_ceiling_bytes is the exact operation or configured-workspace ceiling selected before invocation, does not exceed full_output_bytes_hard_max, and rejects output_size_bytes above it"
    },
    "semantic_objects_default": [
      "private",
      "final",
      "immutable-or-stateless",
      "no-runtime-dispatch",
      "no-separate-build-root",
      "bounded-context-local"
    ]
  },
  "document": "promin.semantic-model",
  "function": "Own the minimal persistent vocabulary, relation grammar, derived-projection boundary, and provider capability contracts.",
  "persistent_entities": [
    {
      "admission_rule": "independent-scheduling-and-acceptance-boundary",
      "kind": "Task",
      "purpose": "Represent one schedulable unit with one acceptance predicate and bounded mutation scope."
    },
    {
      "admission_rule": "independent-candidate-identity-and-consistency-boundary",
      "kind": "Candidate",
      "purpose": "Identify either one provider-proven immutable product snapshot or one explicitly non-creditable observation, independently from control state and bound to the exact candidate recipe."
    },
    {
      "admission_rule": "independent-content-identity-provenance-and-retention-boundary",
      "kind": "Artifact",
      "purpose": "Identify immutable product, evidence, log, report, or diff bytes with provenance and retention metadata; raw-file inventory produces only derived Artifact proxies, while a diff may carry the canonical Candidate-delta change manifest without creating another persistent entity."
    },
    {
      "admission_rule": "independent-execution-attempt-and-evidence-boundary",
      "kind": "Run",
      "purpose": "Record one execution or validation attempt against exact candidate, policy, tool, and input digests."
    },
    {
      "admission_rule": "independent-defect-lifecycle-and-blocking-boundary",
      "kind": "Finding",
      "purpose": "Record an observed defect or policy violation with explicit effective-blocking semantics."
    },
    {
      "admission_rule": "independent-human-judgement-and-target-binding-boundary",
      "kind": "Decision",
      "purpose": "Record a project-operational acceptance, rejection, resolution, waiver, promotion, or release judgement. It is distinct from the external StandardReleaseDecision for the standard distribution."
    },
    {
      "admission_rule": "immutable-task-owned-gate-definition-plus-current-run-and-finalized-artifact-record-bindings",
      "kind": "GateResult",
      "purpose": "Record one gate outcome against the exact immutable Task-owned GateRunDefinition, current Run, and finalized evidence Artifact records; skipped, blocked, failed, stale, or unresolved evidence never receives pass credit."
    },
    {
      "admission_rule": "independent-capability-claim-and-revocation-boundary",
      "kind": "Grant",
      "purpose": "Prove one subject capability within one activation, time interval, nonce, and scope."
    },
    {
      "admission_rule": "independent-mutation-ownership-and-fencing-boundary",
      "kind": "Lease",
      "purpose": "Coordinate temporary mutation ownership through generation, fencing, expiry, heartbeat, and close acknowledgement."
    }
  ],
  "record_type": "SemanticModel",
