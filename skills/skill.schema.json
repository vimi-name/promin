{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Promin Skill Binding",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "record_type": {"const": "ProminSkillBinding"},
    "skill_id": {"type": "string", "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$"},
    "version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"},
    "license": {"type": "string", "minLength": 1, "maxLength": 256},
    "capabilities": {"type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 256}},
    "hosts": {"type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": {"enum": ["generic", "codex", "claude", "cursor", "local"]}},
    "platforms": {"type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": {"enum": ["windows", "macos", "linux", "any"]}},
    "required_tools": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 256}},
    "security_scope": {"enum": ["read-only", "workspace-write", "external-access"]},
    "enabled": {"type": "boolean"},
    "source_kind": {"type": "string", "minLength": 1, "maxLength": 128},
    "source_uri": {"type": ["string", "null"], "maxLength": 2048},
    "source_sha256": {"anyOf": [{"type": "null"}, {"type": "string", "pattern": "^[0-9a-f]{64}$"}]},
    "content_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "required": ["record_type", "skill_id", "version", "license", "capabilities", "hosts", "platforms", "required_tools", "security_scope", "enabled", "source_kind", "source_uri", "source_sha256", "content_digest"]
}
